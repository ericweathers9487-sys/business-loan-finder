    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn in the 512px Play Store icon's coordinates, scaled into the 72dp visible area. -->
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.140625"
        android:scaleY="0.140625">
        <!-- Glow under the ring -->
        <group
            android:pivotX="256"
            android:pivotY="256"
