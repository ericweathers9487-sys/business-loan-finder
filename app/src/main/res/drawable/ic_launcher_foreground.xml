                        <item android:offset="0.97" android:color="#FF10B981" />
                        <item android:offset="1" android:color="#FF10B981" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:pathData="M411,256 A155,155 0 1,1 333.5,121.77"
                android:strokeAlpha="0.09"
                android:strokeLineCap="round"
                android:strokeWidth="56">
