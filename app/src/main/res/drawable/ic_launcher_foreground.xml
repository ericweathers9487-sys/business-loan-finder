            </path>
        </group>
        <!-- Faint light inside the ring -->
        <path android:pathData="M123,256 A133,133 0 1,1 389,256 A133,133 0 1,1 123,256 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="256" android:centerY="200" android:gradientRadius="170">
                    <item android:offset="0" android:color="#12FFFFFF" />
                    <item android:offset="1" android:color="#03FFFFFF" />
