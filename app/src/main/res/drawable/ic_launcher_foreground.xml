                        <item android:offset="0.4167" android:color="#FF34D399" />
                        <item android:offset="0.8333" android:color="#FF22D3EE" />
                        <item android:offset="0.87" android:color="#FF22D3EE" />
                        <item android:offset="0.97" android:color="#FF10B981" />
