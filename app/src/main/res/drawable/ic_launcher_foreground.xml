        <path
            android:pathData="M101,256 A155,155 0 1,1 411,256 A155,155 0 1,1 101,256 Z"
            android:strokeColor="#1FFFFFFF"
            android:strokeWidth="44" />
        <!-- Score arc, starting at 12 o'clock -->
        <group
            android:pivotX="256"
            android:pivotY="256"
            android:rotation="-90">
            <path
                android:pathData="M411,256 A155,155 0 1,1 333.5,121.77"
                android:strokeLineCap="round"
                android:strokeWidth="44">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="sweep" android:centerX="256" android:centerY="256">
                        <item android:offset="0" android:color="#FF10B981" />
