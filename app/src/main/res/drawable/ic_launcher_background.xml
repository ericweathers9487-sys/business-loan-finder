<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: the dark gradient and soft glows of the app's hero panels. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn in the 512px Play Store icon's coordinates, scaled into the 72dp visible area. -->
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.140625"
        android:scaleY="0.140625">
        <path android:pathData="M-128,-128h768v768h-768z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="512" android:endY="512">
                    <item android:offset="0" android:color="#FF0B1324" />
                    <item android:offset="0.5" android:color="#FF0D2A3A" />
                    <item android:offset="1" android:color="#FF0B4A40" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M-128,-128h768v768h-768z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="486" android:centerY="0" android:gradientRadius="380">
                    <item android:offset="0" android:color="#5734D399" />
                    <item android:offset="1" android:color="#0034D399" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M-128,-128h768v768h-768z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="0" android:centerY="512" android:gradientRadius="330">
                    <item android:offset="0" android:color="#2E22D3EE" />
                    <item android:offset="1" android:color="#0022D3EE" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
